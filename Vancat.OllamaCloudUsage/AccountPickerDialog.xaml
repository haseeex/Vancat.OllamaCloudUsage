<platformui:DialogWindow x:Class="Vancat.OllamaCloudUsage.AccountPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="选择账户" Width="420" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
        Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" />

        <ListBox x:Name="AccountList" Grid.Row="1" DisplayMemberPath="Label"
                 MouseDoubleClick="OnDoubleClick" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="确定" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" Click="OnOk" />
            <Button x:Name="CancelButton" Content="取消" Width="80" Height="26" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </Grid>
</platformui:DialogWindow>
