  <Commands package="guidOllamaCloudUsagePackage">
    <Menus>
      <Menu guid="guidOllamaCloudUsageCmdSet" id="OllamaCloudSubMenu" priority="0x0500" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>Ollama Cloud 用量</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidOllamaCloudUsageCmdSet" id="OllamaCloudMenuGroup" priority="0x0000">
        <Parent guid="guidOllamaCloudUsageCmdSet" id="OllamaCloudSubMenu" />
      </Group>
      <Group guid="guidOllamaCloudUsageCmdSet" id="OllamaCloudOtherWindowsGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidOllamaCloudUsageCmdSet" id="cmdidRefreshUsage" priority="0x0100" type="Button">
        <Parent guid="guidOllamaCloudUsageCmdSet" id="OllamaCloudMenuGroup" />
        <Strings>
          <ButtonText>刷新用量</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOllamaCloudUsageCmdSet" id="cmdidOpenUsagePanel" priority="0x0200" type="Button">
        <Parent guid="guidOllamaCloudUsageCmdSet" id="OllamaCloudOtherWindowsGroup" />
        <Strings>
          <ButtonText>Ollama Cloud 用量面板</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOllamaCloudUsageCmdSet" id="cmdidAddAccount" priority="0x0300" type="Button">
        <Parent guid="guidOllamaCloudUsageCmdSet" id="OllamaCloudMenuGroup" />
        <Strings>
          <ButtonText>添加账户</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOllamaCloudUsageCmdSet" id="cmdidRemoveAccount" priority="0x0400" type="Button">
        <Parent guid="guidOllamaCloudUsageCmdSet" id="OllamaCloudMenuGroup" />
        <Strings>
          <ButtonText>移除账户</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidOllamaCloudUsageCmdSet" id="cmdidSetRefreshInterval" priority="0x0500" type="Button">
        <Parent guid="guidOllamaCloudUsageCmdSet" id="OllamaCloudMenuGroup" />
        <Strings>
          <ButtonText>设置自动刷新间隔</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidOllamaCloudUsagePackage" value="{3E9F1A72-8C4B-4D6E-B2A9-5F7C1D8E3A64}" />
