<UserControl x:Class="Vancat.OllamaCloudUsage.Views.OllamaStatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             VerticalAlignment="Center"
             VerticalContentAlignment="Center">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 悬停高亮背景（深浅主题自适应，由代码动态替换） -->
            <SolidColorBrush x:Key="HoverBackground" Color="#22808080" />
            <SolidColorBrush x:Key="MutedText" Color="#FF888888" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <!-- 状态栏主体：悬停显示详细提示，点击打开用量面板 -->
        <Border x:Name="MainArea" Background="Transparent" Padding="6,0,6,0"
                MouseLeftButtonUp="OnMainClick" MouseEnter="OnMainEnter" MouseLeave="OnMainLeave"
                Cursor="Hand">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 云朵图标 -->
                <TextBlock x:Name="IconText" Text="☁" FontSize="11" Margin="0,0,5,0"
                           VerticalAlignment="Center" />
                <!-- 用量文本 -->
                <TextBlock x:Name="UsageText" Text="Ollama" FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 打开详细窗口按钮 -->
        <Border x:Name="OpenButton" Background="Transparent" Padding="5,0,5,0" Margin="2,0,4,0"
                MouseLeftButtonUp="OnOpenPanelClick" MouseEnter="OnButtonEnter" MouseLeave="OnButtonLeave"
                ToolTip="打开 Ollama Cloud 用量面板" Cursor="Hand">
            <TextBlock x:Name="OpenButtonText" Text="▤" FontSize="12" VerticalAlignment="Center" />
        </Border>

        <!-- 悬停详细信息浮窗 -->
        <Popup x:Name="HoverPopup" PlacementTarget="{Binding ElementName=MainArea}"
               Placement="Top" HorizontalOffset="0" VerticalOffset="-6"
               AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="False">
            <Border x:Name="HoverBorder" CornerRadius="4" Padding="10,8"
                    BorderThickness="1" Margin="6" MaxHeight="520"
                    Background="#FF2D2D30" BorderBrush="#FF3F3F46">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HoverContent" MinWidth="220" />
                </ScrollViewer>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
